{
  "manifest_version": 3,
  "name": "REWE Kilopreis-Sortierung",
  "version": "2.0.0",
  "description": "Sortiert Produktlisten im REWE Onlineshop nach dem günstigsten Preis pro kg bzw. Liter. Optional: Brücke zum rewe-mcp-Server.",
  "permissions": [
    "storage",
    "tabs",
    "alarms"
  ],
  "host_permissions": [
    "https://www.rewe.de/*"
  ],
  "options_page": "options.html",
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.rewe.de/shop/*",
        "https://shop.rewe.de/*"
      ],
      "js": [
        "content.js",
        "api.js"
      ],
      "css": [
        "content.css"
      ],
      "run_at": "document_idle"
    }
  ]
}
