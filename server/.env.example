# Kopieren nach .env und anpassen. Die .env niemals einchecken.

# Passwort für den MCP-Zugang (Bearer-Header) und die OAuth-Anmeldeseite. Lang und zufällig wählen:
#   head -c 1024 /dev/urandom | tr -dc A-Za-z0-9 | head -c 32
REWE_MCP_PASSWORD=

# Passwort für die noVNC-Fernansicht (VNC nutzt nur die ersten 8 Zeichen)
REWE_VNC_PASSWORD=

# Adresse der Fernansicht – wird in Fehlermeldungen verlinkt, wenn ein REWE-Login nötig ist
REWE_LOGIN_URL=http://<server-ip>:6080/vnc.html

# --- Optional: Zugang aus dem Internet (z.B. für claude.ai) ---

# Öffentliche HTTPS-Adresse des Servers. Aktiviert die OAuth-Anmeldung.
# REWE_PUBLIC_URL=https://rewe.example.com

# Cloudflare Tunnel starten (Token aus Cloudflare Zero Trust → Networks → Tunnels)
# COMPOSE_PROFILES=tunnel
# CLOUDFLARE_TUNNEL_TOKEN=

# --- Weitere Einstellungen (Standardwerte) ---
# REWE_KEEPALIVE_MIN=4        # Minuten zwischen den Keepalive-Aufrufen
# REWE_MCP_DEBUG=0            # 1 = /debug/fetch aktivieren (nur zur Entwicklung!)
